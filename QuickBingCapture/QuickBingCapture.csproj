<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets .NET Framework 4.8 on purpose: it is built into Windows 10 (1903+) and Windows 11,
    so the app and its installer stay tiny (no bundled runtime needed).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QuickBingCapture</AssemblyName>
    <RootNamespace>QuickBingCapture</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.1.0</Version>
    <Product>Quick Bing Capture</Product>
    <Company>Heshan Induwara</Company>
    <Authors>Heshan Induwara</Authors>
    <Copyright>Copyright (c) 2026 Heshan Induwara</Copyright>
    <Description>Capture a screen region or a whole window and search it with Bing Visual Search.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
